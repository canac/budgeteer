{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "budgeteer",
  "main": "./src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 */3 * * *"] },
  "secrets": {
    "required": ["JWT_SECRET", "AUTH_PASSWORD", "PLAID_ENV", "PLAID_CLIENT_ID", "PLAID_SECRET"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "24f69baaed3942cfaa9114f7f60cd99b",
    },
  ],
}
