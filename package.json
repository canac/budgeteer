{
  "name": "budgeteer",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "mise x --secrets PLAID_ENV,PLAID_CLIENT_ID,PLAID_SECRET -- vite dev",
    "build": "pnpm db:generate && vite build",
    "build:analyze": "ANALYZE=true pnpm build",
    "start": "mise x --secrets PLAID_ENV,PLAID_CLIENT_ID,PLAID_SECRET -- vite start",
    "prepare": "lefthook install",
    "console": "mise x --secrets PLAID_ENV,PLAID_CLIENT_ID,PLAID_SECRET -- node repl.ts",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node seed.ts",
    "fmt": "oxfmt --write .",
    "lint": "oxlint",
    "lint:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/charts": "^9.7.1",
    "@mantine/core": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@prisma/client": "^7.10.0",
    "@std/cache": "jsr:^0.2.4",
    "@std/collections": "jsr:^1.4.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@canac/oxc-config": "^0.1.0",
    "@dotenvx/dotenvx": "^2.38.0",
    "@faker-js/faker": "^10.6.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@prisma/adapter-pg": "^7.10.0",
    "@rolldown/plugin-transform-imports": "^0.1.2",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
